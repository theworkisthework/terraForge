# Dependency cooldown: when npm picks versions (npm install, npm update), it
# only considers releases that have been published for at least this many
# days. Most malicious or broken releases are found and pulled within days, so
# waiting a week avoids installing them.
#
# This applies when the lockfile changes. `npm ci`, which CI and releases use,
# installs exactly what package-lock.json says and is not affected.
#
# To take a fix sooner (a security advisory, say), exempt that package by
# name, for example:
#   min-release-age-exclude[]=electron
# or install it once with `npm install <pkg>@<version> --min-release-age=0`.
min-release-age=7
