{
  "id": "example.spirograph",
  "label": "Spirograph (example)",
  "apiVersion": 1,
  "entry": "index.js",
  "source": "none",
  "renderTimeoutMs": 8000,
  "defaults": { "petals": 7, "ratio": 0.62, "twoPens": false },
  "fields": [
    { "type": "number", "key": "petals", "label": "Petals", "min": 2, "max": 32, "step": 1 },
    { "type": "number", "key": "ratio", "label": "Inner ratio", "control": "slider", "min": 0.05, "max": 0.95, "step": 0.01 },
    { "type": "boolean", "key": "twoPens", "label": "Split across two pens" }
  ]
}
